{
  "name": "rundtisch",
  "main": "./demo/worker/build/index.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "cd demo/worker && cargo install -q worker-build@^0.8 && worker-build --release",
    "watch_dir": ["crates/rundtisch/src", "demo/api/src", "demo/worker/src"]
  },
  "assets": {
    "directory": "./demo/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
