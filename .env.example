# Base URL of the REST backend that serves portfolio and shop data.
# Leave empty (or unset) to use the bundled local sample data.
#
# When set, the app fetches:
#   GET ${VITE_API_BASE_URL}/artworks  -> Artwork[]
#   GET ${VITE_API_BASE_URL}/products  -> Product[]
#
# VITE_API_BASE_URL=https://api.example.com
