{
  "name": "anikaelsa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:locales": "rm -rf public/locales && cp -r src/i18n/locales public/locales",
    "predev": "npm run sync:locales",
    "prebuild": "npm run sync:locales",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --config ../wrangler.jsonc",
    "lint": "eslint ."
  },
  "dependencies": {
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "wrangler": "^4.107.0"
  }
}
