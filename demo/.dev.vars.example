# Local Wrangler secrets (copy to demo/.dev.vars). Native uses the same names as env vars.
# JWT_* must be at least 32 bytes. HASH_PEPPER must be exactly 32 bytes.
JWT_ACCESS_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_VERIFY_SECRET=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
HASH_PEPPER=cccccccccccccccccccccccccccccccc
